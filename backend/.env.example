# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syrian_store?schema=public

# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=5
# "local" or "cloud" — see src/modules/uploads/storage.adapter.ts
STORAGE_DRIVER=local

# Minutes an order may sit in PENDING_PAYMENT before it's auto-cancelled and
# its reserved stock released back to inventory.
ORDER_PENDING_TTL_MIN=20

# ---- Sham Cash (leave blank until official docs/credentials are provided) ----
# If these are left empty, the app automatically uses a MOCK payment
# provider in development so the full checkout flow still works end to end.
# See src/modules/payments/providers/ShamCashPaymentProvider.ts
SHAM_CASH_API_URL=
SHAM_CASH_API_KEY=
SHAM_CASH_MERCHANT_ID=
SHAM_CASH_SECRET=
