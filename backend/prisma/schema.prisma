// ============================================================================
// Syrian E-Commerce Platform — Prisma Schema
// ============================================================================
// Design decisions made explicitly here (these were unresolved gaps in the
// original spec and had to be settled before the schema could be written):
//
// 1. STOCK LEVEL: Stock lives on ProductVariant, never on Product directly.
//    Every purchasable line item MUST resolve to a variant. Products that
//    have no real color/size options still get exactly one "default" variant
//    created automatically. This keeps stock logic uniform everywhere.
//
// 2. STOCK DEDUCTION TIMING: Stock is decremented at ORDER CREATION time
//    (i.e. when the order enters PENDING_PAYMENT), inside a DB transaction,
//    using a conditional update (stock = stock - qty WHERE stock >= qty) so
//    two concurrent requests cannot both succeed for the last unit. This
//    favors "protect the seller from overselling" over "never touch stock
//    until money is confirmed." The tradeoff is handled by decision #3.
//
// 3. ORDER EXPIRY: Orders in PENDING_PAYMENT carry an `expiresAt` timestamp
//    (set at creation, e.g. now + 20 minutes). A scheduled job
//    (see src/jobs/expireOrders.ts) cancels expired orders and restores
//    stock automatically. This prevents stock from being locked forever by
//    abandoned checkouts.
//
// 4. PRICE SNAPSHOTTING: OrderItem stores its own price/name/sku/options at
//    time of purchase. Product/Variant price can change freely afterward
//    without corrupting order history. A separate ProductPriceHistory table
//    keeps an audit trail of price changes for admin transparency (useful
//    given SYP price volatility).
//
// 5. PAYMENT IDEMPOTENCY: Payment has a unique `idempotencyKey` generated by
//    the BACKEND when a payment attempt is initiated (never trusted from the
//    client). Retried "pay now" clicks reuse the same key for the same
//    order+attempt, so no duplicate Payment rows are ever created for one
//    logical attempt. `providerReference` (from Sham Cash) is unique when
//    present, so a webhook/callback replay can never be double-applied.
//
// 6. PHONE VERIFICATION / PASSWORD RESET: schema includes generic
//    VerificationToken model that can back both phone OTP and password
//    reset flows without committing to a specific SMS provider (none was
//    specified — see README "What needs real credentials").
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  ADMIN
  PRODUCT_MANAGER
  ORDER_MANAGER
  DELIVERY_MANAGER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  SHAM_CASH
  MOCK // development/test only — never used in production
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED // soft-deleted; kept because it may be referenced by past orders
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum VerificationPurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGIN_FAILED
  ROLE_CHANGE
}

// ---------------------------------------------------------------------------
// Users (customers)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  phone        String   @unique
  phoneVerified Boolean @default(false)
  email        String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  orders         Order[]
  favorites      Favorite[]
  reviews        Review[]
  cart           Cart?
  refreshTokens  RefreshToken[]
  verificationTokens VerificationToken[]
  couponRedemptions CouponRedemption[]

  @@index([phone])
  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String? // e.g. "المنزل", "العمل"
  governorate String  // المحافظة
  city       String   // المدينة
  area       String?  // المنطقة
  street     String?
  phone      String   // contact phone for this specific address, may differ from account phone
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // never store raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  codeHash  String              // hashed OTP / reset code, never store raw
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Admin users (separate from customer Users — never a shared account)
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id          String      @id @default(uuid())
  adminId     String
  admin       AdminUser   @relation(fields: [adminId], references: [id])
  action      AuditAction
  entityType  String      // e.g. "Product", "Order", "AdminUser"
  entityId    String?
  description String      // human-readable summary
  metadata    Json?       // before/after diff, etc.
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id       String     @id @default(uuid())
  name     String
  nameAr   String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")
  imageUrl String?
  isActive Boolean    @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Product {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  specifications Json?        // flexible key/value spec table
  price         Decimal       @db.Decimal(12, 2) // base display price (see variant note below)
  oldPrice      Decimal?      @db.Decimal(12, 2)
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?        @relation(fields: [brandId], references: [id])
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  favorites     Favorite[]
  priceHistory  ProductPriceHistory[]
  orderItems    OrderItem[]

  // Note: `price`/`oldPrice` here are the DEFAULT variant's price shown in
  // listing cards. Actual chargeable price always comes from the selected
  // ProductVariant at checkout — never trust this field for checkout math.

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductPriceHistory {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice   Decimal  @db.Decimal(12, 2)
  newPrice   Decimal  @db.Decimal(12, 2)
  changedBy  String   // AdminUser id
  createdAt  DateTime @default(now())

  @@index([productId])
  @@map("product_price_history")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

// Every product has >=1 variant, even if it has no real color/size options
// (a "default" variant is created automatically). Stock and SKU always live
// here, never on Product.
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  color     String?
  size      String?
  price     Decimal  @db.Decimal(12, 2) // authoritative price for this exact variant
  stock     Int      @default(0)
  version   Int      @default(0) // optimistic-locking guard, belt-and-suspenders alongside conditional update
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique // human-friendly sequential-ish number, generated server-side
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  addressId     String
  address       Address     @relation(fields: [addressId], references: [id])
  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Decimal     @db.Decimal(12, 2)
  discountTotal Decimal     @db.Decimal(12, 2) @default(0)
  shippingFee   Decimal     @db.Decimal(12, 2) @default(0)
  total         Decimal     @db.Decimal(12, 2)
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  expiresAt     DateTime?   // set when status = PENDING_PAYMENT; used by the expiry job
  cancelledReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  // Snapshotted at purchase time — never re-read from Product/Variant later:
  nameSnapshot String
  skuSnapshot  String
  colorSnapshot String?
  sizeSnapshot  String?
  priceSnapshot Decimal @db.Decimal(12, 2)
  quantity     Int

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?     // AdminUser id, or null for system/automatic transitions
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  provider          PaymentProvider
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("SYP")
  status            PaymentStatus   @default(PENDING)
  idempotencyKey    String          @unique // generated server-side per payment attempt
  transactionId     String?         // our internal reference passed to the provider
  providerReference String?         @unique // Sham Cash's own transaction/reference id, once known
  rawResponse       Json?           // last raw response/webhook payload, for debugging/audit
  failureReason     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Favorites / Reviews
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5, validated at application layer
  comment   String?
  // Reviews are only allowed for verified purchases (order in DELIVERED
  // status containing this product) — enforced in the service layer, not
  // representable purely in the schema.
  orderItemId String? @unique
  isApproved  Boolean @default(true) // moderation hook for later
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id                String     @id @default(uuid())
  code              String     @unique
  type              CouponType
  percentageValue   Int?       // used when type = PERCENTAGE
  fixedValue        Decimal?   @db.Decimal(12, 2) // used when type = FIXED
  minOrderAmount    Decimal?   @db.Decimal(12, 2)
  usageLimitTotal   Int?       // null = unlimited overall
  usageLimitPerUser Int?       // null = unlimited per user
  timesUsed         Int        @default(0)
  isActive          Boolean    @default(true)
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

// Tracks per-user redemption count so usageLimitPerUser can be enforced
// atomically instead of counting orders on every checkout.
model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Shipping configuration (admin-editable fee, kept simple/extensible)
// ---------------------------------------------------------------------------

model ShippingRate {
  id          String   @id @default(uuid())
  governorate String   @unique
  fee         Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("shipping_rates")
}
